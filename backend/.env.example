# ===========================================
# AB & CO. LEGAL CRM — BACKEND CONFIGURATION (.env.example)
# ===========================================
# Documented Environment Variable Specification.
# Copy this file to .env and supply actual deployment values.
# DO NOT COMMIT REAL PRODUCTION SECRETS TO GIT.

# -------------------------------------------
# Database Configuration (PostgreSQL / Supabase)
# [REQUIRED IN PRODUCTION - SERVER SECRET]
# -------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# -------------------------------------------
# Environment & Server Settings
# [REQUIRED IN PRODUCTION - SERVER CONFIG]
# -------------------------------------------
NODE_ENV=production
PORT=3001
API_PREFIX=api/v1

# -------------------------------------------
# Staff Authentication Security
# [REQUIRED IN PRODUCTION - SERVER SECRET]
# -------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-in-production-strong-password-here

# JWT Authentication Keys
# Must use 256-bit cryptographically random strings in production
JWT_SECRET=replace-with-secure-crypto-random-secret-key-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-secure-crypto-refresh-secret-key-32-chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_PORTAL_EXPIRY=1h

# -------------------------------------------
# CORS & Web Origins
# [REQUIRED IN PRODUCTION - SERVER CONFIG]
# -------------------------------------------
FRONTEND_URL=https://abcoflaw.com
CORS_ORIGINS=https://abcoflaw.com,https://admin.abcoflaw.com

# -------------------------------------------
# n8n Automation Webhooks & HMAC Security
# [REQUIRED IN PRODUCTION - SERVER SECRET]
# -------------------------------------------
N8N_WEBHOOK_URL=http://localhost:5678/webhook/appointment-created
N8N_WEBHOOK_SECRET=replace-with-secure-hmac-sha256-signing-secret

# -------------------------------------------
# Storage & Upload Limits
# [OPTIONAL / SERVER CONFIG]
# -------------------------------------------
UPLOAD_DESTINATION=./uploads
UPLOAD_MAX_SIZE=10485760

# -------------------------------------------
# Rate Limiting & Abuse Prevention
# [REQUIRED IN PRODUCTION - SERVER CONFIG]
# -------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
